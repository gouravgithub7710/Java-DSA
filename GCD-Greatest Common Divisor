class Solution {
    public static int gcd(int a, int b) {
        // Jab tak b zero nahi hota, loop chalta rahega
        while (b != 0) {
            
            // temp me b ko store kar lete hain (kyunki a ko b me dalne se pehle b ki value chahiye hogi)
            int temp = b;
            
            // b ko update karte hain: ab b ban jaayega a % b (remainder)
            b = a % b;
            
            // a ko update karte hain: ab a ban jaayega purana b (jo temp me tha)
            a = temp;
        }
        
        // Jab b = 0 ho jaata hai, us waqt a hi GCD hota hai
        return a;
    }
}


